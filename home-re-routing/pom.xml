<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>naikeri-home-rerouting</artifactId>
        <groupId>com.naikeri</groupId>
        <version>2.2.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>home-re-routing</artifactId>
    
    <dependencies>
        <dependency>
            <!-- The library this application runs on, which used to be vendored as a copy in core/ -->
            <groupId>com.naikeri</groupId>
            <artifactId>naikeri-signaling-gateway-core</artifactId>
            <version>${naikeri-signaling-gateway-core.version}</version>
            <exclusions>
                <!-- sctp-impl declares TestNG at compile scope, which puts it in this jar's lib/ and makes
                     surefire pick the TestNG provider for a module that has no tests. -->
                <exclusion>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                </exclusion>
                <!-- jSS7's map-impl ships a JAXB API and a second JAXB provider; both belong to the
                     application, not to a protocol library. -->
                <exclusion>
                    <groupId>sun-jaxb</groupId>
                    <artifactId>jaxb-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.sun.xml.bind</groupId>
                    <artifactId>jaxb-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <!-- runtime scope only: without this, JUnit and Hamcrest are copied into the
                                 distribution's lib/ alongside what the agent actually needs. -->
                            <includeScope>runtime</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build an executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>com.naikeri.hrr.impl.HomeReRouting</mainClass>
                        </manifest>
                    </archive>
                    <excludes>
                        <!-- Everything in src/main/resources is deployment configuration: it belongs
                             beside the jar, where an operator can edit it, not inside it. -->
                        <exclude>*.xml</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>