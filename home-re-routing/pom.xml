<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>naikeri-home-rerouting</artifactId>
        <groupId>com.naikeri</groupId>
        <version>2.2.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.naikeri</groupId>
    <artifactId>home-re-routing</artifactId>
    <version>2.2.0</version>
    
    <dependencies>
        <dependency>
            <!-- The library this application runs on, which used to be vendored as a copy in core/ -->
            <groupId>com.naikeri</groupId>
            <artifactId>naikeri-signaling-gateway-core</artifactId>
            <version>${naikeri-signaling-gateway-core.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <!-- com/naikeri/prototype is the MAP and CAMEL test rig, still written against jSS7 8.5:
                     removed constructors and changed add*Request signatures. Excluded until it is brought
                     up to jSS7 9, which is its own job; nothing in the proxy engine depends on it. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler.plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/naikeri/prototype/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build an executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>com.naikeri.hrr.impl.HomeReRouting</mainClass>
                        </manifest>
                    </archive>
                    <excludes>
                        <exclude>log4j.xml</exclude>
                        <exclude>naikeri-signaling-gateway.xml</exclude>
                        <exclude>map-application-rules.xml</exclude>
                        <exclude>map-configuration-layers.xml</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>