<?xml version="1.0" encoding="UTF-8" ?>
<Rules>
  <!-- Testing PC error-->
  <Rule name="1-SendAuthenticationInfo request" regex="true">
    <Match ClgGt="\d+" CldGt="^9725404\d+" Imsi="^4251004\d+" primitives="sendAuthenticationInfo_Request" />
    <Replace>
      <Imsi value="4251004" pattern="^\d{7}" />
      <CldGt value="9725407" pattern="^\d{7}" translationType="0" encodingScheme="1" numberingPlan="7" natureOfAddress="INTERNATIONAL" ssn="0" dpc="0" ri="ROUTING_BASED_ON_GLOBAL_TITLE" />
    </Replace>
  </Rule>

  <Rule name="2-SendAuthenticationInfo Response" regex="true">
    <Match ClgGt="\d+" CldGt="^383\d+" Imsi="^4251004\d+" primitives="sendAuthenticationInfo_Response" />
    <Replace>
      <CldGt value="972" pattern="^\d{3}" translationType="0" encodingScheme="1" numberingPlan="1" natureOfAddress="INTERNATIONAL" />
    </Replace>
  </Rule>

