        <patternSccpAddress routingIndicator="ROUTING_BASED_ON_GLOBAL_TITLE" dpc="0" ssn="0" aivalue="18">
          <gt type="GT0100" translationType="0" encodingScheme="2" numberingPlan="1" natureOfAddress="INTERNATIONAL" digits="*" />
        </patternSccpAddress>
